# Environment Configuration for ResolveFlow AI Backend
NODE_ENV=production
PORT=5001

# Frontend URL (e.g. your Vercel deployment URL)
# Example: https://resolve-flow-ai.vercel.app
CLIENT_URL=http://localhost:5175

# MongoDB Atlas Connection String with Atlas Vector Search capability
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resolveflowai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
ATLAS_VECTOR_INDEX=policy_vector_index

# Cloudinary (Optional image attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Retries & Timeouts
MAX_AI_RETRIES=3
AI_REQUEST_TIMEOUT_MS=30000
